# API Settings
API_VERSION=v1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["*"]

# Model Settings
DEFAULT_MODEL=microsoft/codebert-base
MODEL_CACHE_DIR=models/cache
MAX_MODEL_CACHE_SIZE_GB=10

# Training Settings
DEFAULT_BATCH_SIZE=8
DEFAULT_LEARNING_RATE=2e-5
DEFAULT_NUM_EPOCHS=3
MAX_SEQUENCE_LENGTH=512
USE_LORA=True
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05

# Dataset Settings
DATASET_BASE_PATH=datasets
VBA_MACROS_PATH=datasets/vba_macros
API_REFERENCES_PATH=datasets/api_references
GEOMETRY_JSON_PATH=datasets/geometry_json
PROMPTS_PATH=datasets/prompts
TRAINING_SAMPLES_PATH=datasets/training_samples

# Validation Settings
ENABLE_STRICT_VALIDATION=True
VALIDATE_API_CALLS=True
CODE_TEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database
DATABASE_URL=sqlite:///./solidworks_vba_ml.db

# Generation Settings
DEFAULT_MAX_LENGTH=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
